# ── Production environment variables for Railway ──
# Copy these into Railway Dashboard → Variables

# MongoDB Atlas (get free URI from https://cloud.mongodb.com)
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/proxispeak

# Redis (get free URI from https://railway.app or https://upstash.com)
# Leave blank if not using Redis — server works without it
REDIS_URL=

# Port — Railway sets this automatically, don't change
PORT=3001
